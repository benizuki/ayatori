# scripts/gce/cos.env にコピーし、環境に合わせて編集してください。
# 別のファイルは COS_ENV_FILE=/path/to/cos.env で指定できます。

# 必須: GCP プロジェクトと配置先
PROJECT_ID="your-gcp-project"
REGION="asia-northeast1"
ZONE="asia-northeast1-c"

# アプリ / Artifact Registry
SERVICE_NAME="ayatori"
AR_REPO="ayatori"
# 外部のCloud Buildなどでpush済みのタグを指定します。未指定時はlatestです。
IMAGE_TAG="latest"

# COS VM
VM_NAME="${SERVICE_NAME}-vm"
MACHINE_TYPE="e2-small"
BOOT_DISK_SIZE="30GB"
BOOT_DISK_TYPE="pd-balanced"
NETWORK="default"
SUBNET="default"
NETWORK_TAGS="${SERVICE_NAME},lb-health-check"

# false の場合、Artifact Registry / Secret Manager / Vertex AI へ到達できる
# Cloud NAT または Private Google Access をサブネット側で用意してください。
ASSIGN_EXTERNAL_IP="true"

# 永続ディスク
DATA_DISK_NAME="${SERVICE_NAME}-data"
DATA_DISK_SIZE="50GB"
DATA_DISK_TYPE="pd-balanced"

# 実行サービスアカウント。SA_ID は 6～30 文字にしてください。
SA_ID="${SERVICE_NAME}-sa"

# Secret Manager
APP_AUTH_SECRET_ID="${SERVICE_NAME}-app-auth-secret"
# Secret が存在しない場合にランダム値で自動作成します。
CREATE_APP_AUTH_SECRET="true"

# アプリ設定
GOOGLE_CLOUD_LOCATION="global"
VERTEX_GEMINI_MODEL="gemini-3.5-flash"
# 会話の応答速度を優先するため、ヒアリングは LOW を既定にします。
VERTEX_INTERVIEW_THINKING_LEVEL="LOW"
# 業務フロー図・業務一覧の専用解析モデル。空なら VERTEX_GEMINI_MODEL を使用します。
VERTEX_DOCUMENT_MODEL=""
# 多数工程・表の全行を精査するため、文書解析は HIGH を既定にします。
VERTEX_DOCUMENT_THINKING_LEVEL="HIGH"
GEMINI_TTS_MODEL="gemini-2.5-flash-tts"
GEMINI_TTS_VOICE="Sulafat"
GEMINI_TTS_SPEAKING_RATE="1.0"

# Google OAuth を使わない場合は空のままにします。
GOOGLE_OAUTH_CLIENT_ID=""

# 同一オリジンだけで利用する場合は空のままで構いません。
# 別オリジンのフロントエンドを許可する場合に指定します。
AYATORI_CORS_ORIGINS=""

# コンテナ公開ポート
HOST_PORT="8080"
CONTAINER_PORT="8080"

# ロードバランサ（create-regional-https-load-balancer.sh で使用）
LB_NAME="${SERVICE_NAME}-lb"
# Google管理証明書を発行するドメイン。
DOMAIN=""
# TLSの下限。既定のSSLポリシーはTLS1.0まで許すため、明示したポリシーを付けます。
SSL_POLICY_PROFILE="MODERN"
SSL_MIN_TLS_VERSION="1.3"

# Cloud Armor（ロードバランサのバックエンドサービスに適用）
CLOUD_ARMOR_ENABLED="false"
# WAFとレート制限は最初は検知のみ。ログで誤検知がないことを確認してから false にします。
CLOUD_ARMOR_WAF_PREVIEW="true"
CLOUD_ARMOR_RATE_LIMIT_PREVIEW="true"
# 接続元IPの制限。カンマ区切りでCIDRか単一IPを列挙すると、ここに載っていないIPを拒否します。
# 空にするとIPによる制限は行いません（例: "203.0.113.10,198.51.100.0/24"）。
CLOUD_ARMOR_ALLOWED_IP_RANGES=""
# 締め出しが不安な間は true にすると、拒否せずログにだけ残します。
CLOUD_ARMOR_IP_ALLOWLIST_PREVIEW="false"
# 送信元IPごとのレート制限と、超過が続いた場合の一時BAN
CLOUD_ARMOR_RATE_LIMIT_COUNT="100"
CLOUD_ARMOR_RATE_LIMIT_INTERVAL_SEC="60"
CLOUD_ARMOR_BAN_THRESHOLD_COUNT="300"
CLOUD_ARMOR_BAN_THRESHOLD_INTERVAL_SEC="120"
CLOUD_ARMOR_BAN_DURATION_SEC="600"
