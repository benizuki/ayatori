GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-3.6-flash
# 読み上げの既定エンジンは cloud-tts。モデルは CLOUD_TTS_MODEL で指定する
# （GEMINI_TTS_MODEL は AYATORI_TTS_ENGINE=gemini-tts のときだけ効く）。
CLOUD_TTS_MODEL=gemini-2.5-flash-tts
GEMINI_TTS_VOICE=Sulafat
GEMINI_TTS_SPEAKING_RATE=1.0
AYATORI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
